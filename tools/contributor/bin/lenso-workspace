#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if git_common_directory="$(git -C "$script_directory" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  default_framework_root="$(cd "$(dirname "$git_common_directory")/.." && pwd -P)"
else
  default_framework_root="$(cd "$script_directory/../.." && pwd -P)"
fi
framework_root="${LENSO_FRAMEWORK_ROOT:-$default_framework_root}"
framework_root="$(cd "$framework_root" && pwd -P)"
command_name="${1:-snapshot}"
output_json=false
perform_fetch=false

usage() {
  printf 'Usage: lenso-workspace snapshot|doctor|release-status [--json] [--fetch|--no-fetch]\n'
}

if [ "$command_name" = "-h" ] || [ "$command_name" = "--help" ]; then
  usage
  exit 0
fi
shift || true

case "$command_name" in
  snapshot|doctor) ;;
  release-status) perform_fetch=true ;;
  *) printf 'Unknown command: %s\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) output_json=true ;;
    --fetch) perform_fetch=true ;;
    --no-fetch) perform_fetch=false ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

required_commands=(git jq wt)
if [ "$command_name" = "release-status" ]; then
  required_commands+=(gh rg)
fi
missing_tools=()
for required_command in "${required_commands[@]}"; do
  command -v "$required_command" >/dev/null 2>&1 || missing_tools+=("$required_command")
done

if [ "${#missing_tools[@]}" -gt 0 ] && [ "$command_name" != "doctor" ]; then
  printf 'ERROR missing command(s): %s\n' "${missing_tools[*]}" >&2
  exit 1
fi

records_file="$(mktemp -t lenso-workspace-records.XXXXXX)"
pins_file="$(mktemp -t lenso-workspace-pins.XXXXXX)"
pin_matches_file="$(mktemp -t lenso-workspace-pin-matches.XXXXXX)"
prs_file="$(mktemp -t lenso-workspace-prs.XXXXXX)"
pr_status_dir="$(mktemp -d -t lenso-workspace-pr-status.XXXXXX)"
worktree_status_dir="$(mktemp -d -t lenso-workspace-worktrees.XXXXXX)"
fetch_status_dir="$(mktemp -d -t lenso-workspace-fetch.XXXXXX)"
cleanup_records() {
  for temporary_file in "$records_file" "$pins_file" "$pin_matches_file" "$prs_file"; do
    unlink "$temporary_file" 2>/dev/null || true
  done
  for status_file in "$pr_status_dir"/*; do
    [ -e "$status_file" ] || continue
    unlink "$status_file" 2>/dev/null || true
  done
  rmdir "$pr_status_dir" 2>/dev/null || true
  for worktree_status_file in "$worktree_status_dir"/*; do
    [ -e "$worktree_status_file" ] || continue
    unlink "$worktree_status_file" 2>/dev/null || true
  done
  rmdir "$worktree_status_dir" 2>/dev/null || true
  for fetch_status_file in "$fetch_status_dir"/*; do
    [ -e "$fetch_status_file" ] || continue
    unlink "$fetch_status_file" 2>/dev/null || true
  done
  rmdir "$fetch_status_dir" 2>/dev/null || true
}
trap cleanup_records EXIT

github_repository_slug() {
  local remote_url="$1"
  local repository_slug
  case "$remote_url" in
    https://github.com/*) repository_slug="${remote_url#https://github.com/}" ;;
    git@github.com:*) repository_slug="${remote_url#git@github.com:}" ;;
    ssh://git@github.com/*) repository_slug="${remote_url#ssh://git@github.com/}" ;;
    *) return 1 ;;
  esac
  repository_slug="${repository_slug%.git}"
  if [[ "$repository_slug" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    printf '%s\n' "$repository_slug"
    return 0
  fi
  return 1
}

github_pr_list() {
  local repository_slug="$1"
  local output_file="$2"
  local error_file="$3"
  local attempt=1
  while [ "$attempt" -le 2 ]; do
    if gh pr list \
      --repo "$repository_slug" \
      --state open \
      --limit 100 \
      --json number,state,title,url,isDraft,updatedAt,statusCheckRollup \
      > "$output_file.next" 2> "$error_file" \
      && jq -e 'type == "array"' "$output_file.next" >/dev/null 2>&1; then
      mv "$output_file.next" "$output_file"
      unlink "$error_file" 2>/dev/null || true
      return 0
    fi
    unlink "$output_file.next" 2>/dev/null || true
    attempt=$((attempt + 1))
    [ "$attempt" -gt 2 ] || sleep 1
  done
  if [ ! -s "$error_file" ]; then
    printf 'GitHub returned an invalid pull-request response\n' > "$error_file"
  fi
  return 1
}

fetch_with_deadline() {
  local repository="$1"
  local error_file="$2"
  local timeout_marker="$error_file.timeout"
  local fetch_pid
  local watchdog_pid
  local fetch_result
  set +e
  GIT_TERMINAL_PROMPT=0 git -C "$repository" \
    -c http.lowSpeedLimit=1 \
    -c http.lowSpeedTime=15 \
    fetch origin --prune >/dev/null 2> "$error_file" &
  fetch_pid=$!
  (
    sleep 20
    printf 'git fetch origin --prune timed out after 20 seconds\n' > "$timeout_marker"
    kill -TERM "$fetch_pid" 2>/dev/null
  ) &
  watchdog_pid=$!
  wait "$fetch_pid"
  fetch_result=$?
  kill "$watchdog_pid" 2>/dev/null
  wait "$watchdog_pid" 2>/dev/null
  if [ "$fetch_result" -eq 0 ]; then
    unlink "$error_file" 2>/dev/null
    unlink "$timeout_marker" 2>/dev/null
  elif [ -s "$timeout_marker" ]; then
    timeout_detail="$(<"$timeout_marker")"
    printf '%s\n' "$timeout_detail" >> "$error_file"
  elif [ ! -s "$error_file" ]; then
    printf 'git fetch origin --prune failed with exit %s\n' "$fetch_result" > "$error_file"
  fi
  exit 0
}

fetch_pids=()
if $perform_fetch; then
  for fetch_repo_root in "$framework_root"/*; do
    [ -d "$fetch_repo_root" ] || continue
    git -C "$fetch_repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
    fetch_git_common_dir="$(git -C "$fetch_repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    [ "$fetch_git_common_dir" = "$fetch_repo_root/.git" ] || continue
    fetch_repo_name="$(basename "$fetch_repo_root")"
    fetch_with_deadline "$fetch_repo_root" "$fetch_status_dir/$fetch_repo_name.error" &
    fetch_pids+=("$!")
  done
  if [ "${#fetch_pids[@]}" -gt 0 ]; then
    for fetch_pid in "${fetch_pids[@]}"; do
      wait "$fetch_pid"
    done
  fi
fi

repository_count=0
worktree_status_pids=()
for repo_root in "$framework_root"/*; do
  [ -d "$repo_root" ] || continue
  git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
  git_common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  [ "$git_common_dir" = "$repo_root/.git" ] || continue
  repository_count=$((repository_count + 1))

  repo_name="$(basename "$repo_root")"
  fetch_error=""
  if $perform_fetch && [ -s "$fetch_status_dir/$repo_name.error" ]; then
    fetch_error="$(<"$fetch_status_dir/$repo_name.error")"
  fi

  default_ref="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -z "$default_ref" ] && git -C "$repo_root" rev-parse --verify origin/main >/dev/null 2>&1; then
    default_ref="origin/main"
  fi
  default_branch="${default_ref#origin/}"
  branch_name="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null || printf DETACHED)"
  head_sha="$(git -C "$repo_root" rev-parse HEAD)"
  origin_default=""
  ahead=0
  behind=0
  if [ -n "$default_ref" ]; then
    origin_default="$(git -C "$repo_root" rev-parse --verify "$default_ref" 2>/dev/null || true)"
  fi
  if [ -n "$origin_default" ]; then
    read -r ahead behind < <(git -C "$repo_root" rev-list --left-right --count "HEAD...$default_ref")
  fi
  dirty=false
  [ -z "$(git -C "$repo_root" status --porcelain=v1 --untracked-files=normal)" ] || dirty=true
  latest_tag="$(git -C "$repo_root" describe --tags --abbrev=0 2>/dev/null || true)"
  commits_since_tag=""
  if [ -n "$latest_tag" ]; then
    commits_since_tag="$(git -C "$repo_root" rev-list --count "$latest_tag"..HEAD)"
  fi
  remote_url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
  worktree_count="$(git -C "$repo_root" worktree list --porcelain | awk '/^worktree / { count += 1 } END { print count + 0 }')"

  worktree_status='{"schema":2,"items":[]}'
  worktree_status_index=-1
  if [ "$command_name" != "snapshot" ] && command -v wt >/dev/null 2>&1; then
    worktree_status_index=$((repository_count - 1))
    printf -v worktree_status_file '%s/%06d.json' "$worktree_status_dir" "$worktree_status_index"
    (
      worktree_error_file="$worktree_status_file.error"
      worktree_candidate_file="$worktree_status_file.next"
      if wt -C "$repo_root" list --format=json > "$worktree_candidate_file" 2> "$worktree_error_file" \
        && jq -e 'type == "object" and (.items | type == "array")' "$worktree_candidate_file" >/dev/null 2>&1; then
        mv "$worktree_candidate_file" "$worktree_status_file"
        unlink "$worktree_error_file" 2>/dev/null || true
      else
        worktree_error="$(sed -n '1,3p' "$worktree_error_file")"
        [ -n "$worktree_error" ] || worktree_error="wt list returned an invalid response"
        jq -cn --arg error "$worktree_error" '{schema:2,items:[],error:$error}' > "$worktree_status_file"
        unlink "$worktree_candidate_file" 2>/dev/null || true
      fi
    ) &
    worktree_status_pids+=("$!")
    worktree_status=null
  fi

  jq -cn \
    --arg name "$repo_name" \
    --arg path "$repo_root" \
    --arg remoteUrl "$remote_url" \
    --arg defaultBranch "$default_branch" \
    --arg branch "$branch_name" \
    --arg head "$head_sha" \
    --arg originDefault "$origin_default" \
    --arg latestTag "$latest_tag" \
    --arg commitsSinceTag "$commits_since_tag" \
    --arg fetchError "$fetch_error" \
    --argjson dirty "$dirty" \
    --argjson ahead "$ahead" \
    --argjson behind "$behind" \
    --argjson worktreeCount "$worktree_count" \
    --argjson worktreeStatus "$worktree_status" \
    --argjson worktreeStatusIndex "$worktree_status_index" \
    '{name:$name,path:$path,remoteUrl:$remoteUrl,defaultBranch:$defaultBranch,branch:$branch,head:$head,originDefault:$originDefault,dirty:$dirty,ahead:$ahead,behind:$behind,worktreeCount:$worktreeCount,latestTag:$latestTag,commitsSinceTag:(if $commitsSinceTag == "" then null else ($commitsSinceTag|tonumber) end),fetchError:(if $fetchError == "" then null else $fetchError end),worktreeStatus:$worktreeStatus,worktreeStatusIndex:$worktreeStatusIndex}' \
    >> "$records_file"
done

if [ "${#worktree_status_pids[@]}" -gt 0 ]; then
  for worktree_status_pid in "${worktree_status_pids[@]}"; do
    wait "$worktree_status_pid"
  done
  worktree_statuses="$(jq -sc '.' "$worktree_status_dir"/*.json)"
else
  worktree_statuses='[]'
fi

if [ "$command_name" = "release-status" ]; then
  pin_scan_error=""
  set +e
  rg --json --glob 'Cargo.lock' \
    'git\+https://github\.com/LioRael/[A-Za-z0-9._-]+(?:\.git)?(?:\?rev=[0-9a-f]{7,40})?(?:#[0-9a-f]{7,40})?' \
    "$framework_root" > "$pin_matches_file" 2> "$pr_status_dir/pin-scan.error"
  pin_scan_exit=$?
  set -e
  if [ "$pin_scan_exit" -eq 0 ] || [ "$pin_scan_exit" -eq 1 ]; then
    if ! jq -c --arg root "$framework_root/" '
        select(.type == "match")
        | .data as $data
        | ($data.path.text | sub("^" + $root; "") | split("/")[0]) as $consumer
        | $data.submatches[].match.text
        | capture("git\\+https://github\\.com/LioRael/(?<provider>[A-Za-z0-9._-]+?)(?:\\.git)?(?:\\?rev=(?<requestedRev>[0-9a-f]{7,40}))?(?:#(?<resolvedRev>[0-9a-f]{7,40}))?$")
        | . + {consumer:$consumer}
      ' "$pin_matches_file" > "$pins_file" 2> "$pr_status_dir/pin-parse.error"; then
      pin_scan_error="dependency pin evidence could not be parsed: $(sed -n '1,3p' "$pr_status_dir/pin-parse.error")"
    fi
  else
    pin_scan_error="dependency pin scan failed: $(sed -n '1,3p' "$pr_status_dir/pin-scan.error")"
  fi

  pr_query_error=""
  pr_query_batch_pids=()
  pr_query_index=0
  while IFS=$'\t' read -r repository_remote_url; do
    if repository_slug="$(github_repository_slug "$repository_remote_url")"; then
      printf '%s\n' "$repository_slug" > "$pr_status_dir/$pr_query_index.repository"
      github_pr_list \
        "$repository_slug" \
        "$pr_status_dir/$pr_query_index.json" \
        "$pr_status_dir/$pr_query_index.error" &
      pr_query_batch_pids+=("$!")
      pr_query_index=$((pr_query_index + 1))
      if [ "${#pr_query_batch_pids[@]}" -ge 6 ]; then
        for pr_query_pid in "${pr_query_batch_pids[@]}"; do
          wait "$pr_query_pid" || true
        done
        pr_query_batch_pids=()
      fi
    fi
  done < <(jq -r '.remoteUrl | select(length > 0)' "$records_file" | sort -u)
  if [ "${#pr_query_batch_pids[@]}" -gt 0 ]; then
    for pr_query_pid in "${pr_query_batch_pids[@]}"; do
      wait "$pr_query_pid" || true
    done
  fi

  for repository_file in "$pr_status_dir"/*.repository; do
    [ -e "$repository_file" ] || continue
    pr_query_index="$(basename "$repository_file" .repository)"
    repository_slug="$(<"$repository_file")"
    if [ -s "$pr_status_dir/$pr_query_index.json" ]; then
      jq -c --arg repository "$repository_slug" '
        def conclusion_state:
          (.conclusion // "" | ascii_upcase) as $conclusion
          | (.status // "" | ascii_upcase) as $status
          | if ($status != "" and $status != "COMPLETED") or $conclusion == "" then "pending"
            elif ["ACTION_REQUIRED","CANCELLED","FAILURE","STALE","STARTUP_FAILURE","TIMED_OUT"] | index($conclusion) then "failure"
            else "success"
            end;
        def context_state:
          (.state // "" | ascii_upcase) as $state
          | if ["ERROR","FAILURE"] | index($state) then "failure"
            elif ["EXPECTED","PENDING"] | index($state) then "pending"
            else "success"
            end;
        .[]
        | ([.statusCheckRollup[]? | if has("conclusion") then conclusion_state else context_state end]) as $states
        | {
            number,
            repository:$repository,
            state,
            title,
            url,
            isDraft,
            updatedAt,
            checks:(
              if ($states | length) == 0 then "unknown"
              elif ($states | index("failure")) != null then "failure"
              elif ($states | index("pending")) != null then "pending"
              else "success"
              end
            )
          }
      ' "$pr_status_dir/$pr_query_index.json" >> "$prs_file"
    else
      pr_error_detail="$(sed -n '1,3p' "$pr_status_dir/$pr_query_index.error")"
      [ -n "$pr_error_detail" ] || pr_error_detail="unknown GitHub CLI error"
      if [ -n "$pr_query_error" ]; then
        pr_query_error="$pr_query_error; "
      fi
      pr_query_error="${pr_query_error}${repository_slug}: ${pr_error_detail}"
    fi
  done
fi

if [ "${#missing_tools[@]}" -eq 0 ]; then
  missing_tools_json='[]'
else
  missing_tools_json="$(printf '%s\n' "${missing_tools[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
fi
workspace_json="$(jq -sc \
  --arg schema "lenso.workspace-snapshot.v2" \
  --arg root "$framework_root" \
  --arg command "$command_name" \
  --argjson fetched "$perform_fetch" \
  --argjson missingTools "$missing_tools_json" \
  --argjson worktreeStatuses "$worktree_statuses" \
  '{schema:$schema,root:$root,command:$command,fetched:$fetched,missingTools:$missingTools,repositories:(map(
    if .worktreeStatusIndex >= 0 then
      .worktreeStatus = ($worktreeStatuses[.worktreeStatusIndex] // {schema:2,items:[],error:"wt list result missing"})
    else . end
    | del(.worktreeStatusIndex)
  ))}' \
  "$records_file")"

if [ "$command_name" = "doctor" ]; then
  workspace_json="$(jq -c --argjson repositoryCount "$repository_count" '
    def changed:
      .staged or .modified or .untracked or .renamed or .deleted or .conflicted;
    ([.repositories[] | select(.fetchError != null) | {repository:.name,error:.fetchError}]) as $fetchFailures
    | ([.repositories[] | select(.worktreeStatus.error? != null)
        | {repository:.name,error:.worktreeStatus.error}]) as $worktreeStatusFailures
    | ([.repositories[] as $repository
        | $repository.worktreeStatus.items[]?
        | select(.worktree != null and (.worktree.changes | changed))
        | {repository:$repository.name,branch:(.branch // "DETACHED"),path:.worktree.path}]) as $dirtyWorktrees
    | ([.repositories[] | select(.ahead > 0 or .behind > 0)
        | {repository:.name,ahead,behind}]) as $divergedRepositories
    | ([.repositories[] as $repository
        | $repository.worktreeStatus.items[]?
        | select((.operation_state // "none") != "none"
          or (.worktree.state? // "") == "prunable"
          or (.worktree.state? // "") == "locked")
        | {repository:$repository.name,branch:(.branch // "DETACHED"),operation:(.operation_state // null),state:(.worktree.state // null)}]) as $unsafeWorktrees
    | . + {
        schema:"lenso.workspace-doctor.v2",
        checks:{
          repositoryCount:$repositoryCount,
          missingTools:.missingTools,
          fetchFailures:$fetchFailures,
          worktreeStatusFailures:$worktreeStatusFailures,
          dirtyWorktrees:$dirtyWorktrees,
          divergedRepositories:$divergedRepositories,
          unsafeWorktrees:$unsafeWorktrees
        },
        status:(
          if (.missingTools|length) > 0 or $repositoryCount == 0 or ($fetchFailures|length) > 0 or ($worktreeStatusFailures|length) > 0 or ($unsafeWorktrees|length) > 0
          then "failed"
          elif ($dirtyWorktrees|length) > 0 or ($divergedRepositories|length) > 0
          then "attention"
          else "passed"
          end
        )
      }
  ' <<< "$workspace_json")"
elif [ "$command_name" = "release-status" ]; then
  dependency_pins="$(jq -sc 'unique_by([.consumer,.provider,.requestedRev,.resolvedRev]) | sort_by([.provider,.consumer])' "$pins_file")"
  pull_requests="$(jq -sc 'sort_by([.repository,.number])' "$prs_file")"
  workspace_json="$(jq -c --argjson dependencyPins "$dependency_pins" --argjson pullRequests "$pull_requests" --arg pinScanError "$pin_scan_error" --arg prQueryError "$pr_query_error" '
    . as $workspace
    | ([.repositories[] | select(.worktreeStatus.error? != null)
        | {repository:.name,error:.worktreeStatus.error}]) as $worktreeStatusFailures
    | . + {
        schema:"lenso.workspace-release-status.v2",
        pullRequests:$pullRequests,
        prQueryError:(if $prQueryError == "" then null else $prQueryError end),
        pinScanError:(if $pinScanError == "" then null else $pinScanError end),
        worktreeStatusFailures:$worktreeStatusFailures,
        status:(
          if $prQueryError == ""
            and $pinScanError == ""
            and ([.repositories[] | select(.fetchError != null)] | length) == 0
            and ($worktreeStatusFailures | length) == 0
          then "complete"
          else "failed"
          end
        ),
        dependencyPins:($dependencyPins | map(
          . as $pin
          | ([ $workspace.repositories[] | select(.name == $pin.provider) | .originDefault ][0] // null) as $providerHead
          | . + {
              providerHead:$providerHead,
              status:(
                if (.resolvedRev // "") == "" then "floating"
                elif $providerHead == .resolvedRev then "current-main"
                else "pinned-revision"
                end
              )
            }
        ))
      }
  ' <<< "$workspace_json")"
fi

if $output_json; then
  jq . <<< "$workspace_json"
else
  printf 'COMMAND\t%s\n' "$command_name"
  printf 'ROOT\t%s\n' "$framework_root"
  printf 'FETCHED\t%s\n' "$perform_fetch"
  jq -r '.repositories[] | [.name,.branch,(if .dirty then "dirty" else "clean" end),("ahead="+(.ahead|tostring)),("behind="+(.behind|tostring)),("worktrees="+(.worktreeCount|tostring)),("tag="+(if .latestTag == "" then "none" else .latestTag end)),(if .fetchError == null then "fetch=ok" else "fetch=failed" end)] | @tsv' <<< "$workspace_json"
  if [ "$command_name" = "doctor" ]; then
    jq -r '
      "STATUS\t" + .status,
      (.checks.missingTools[]? | "MISSING_TOOL\t" + .),
      (.checks.fetchFailures[]? | "FETCH_FAILED\t" + .repository),
      (.checks.worktreeStatusFailures[]? | "WORKTREE_STATUS_FAILED\t" + .repository),
      (.checks.unsafeWorktrees[]? | "UNSAFE_WORKTREE\t" + .repository + "\t" + .branch),
      (.checks.dirtyWorktrees[]? | "DIRTY_WORKTREE\t" + .repository + "\t" + .branch),
      (.checks.divergedRepositories[]? | "DIVERGED\t" + .repository + "\tahead=" + (.ahead|tostring) + "\tbehind=" + (.behind|tostring))
    ' <<< "$workspace_json"
  elif [ "$command_name" = "release-status" ]; then
    jq -r '.repositories[] as $repository | $repository.worktreeStatus.items[]? | select(.worktree != null and .worktree.main != true) | ["WORKTREE",$repository.name,(.branch // "DETACHED"),(.display.main_state // "unknown")]|@tsv' <<< "$workspace_json"
    jq -r '.pullRequests[]? | ["PR",.repository,(.number|tostring),.checks,(if .isDraft then "draft" else .state end),.url]|@tsv' <<< "$workspace_json"
    jq -r '.dependencyPins[]? | ["PIN",.consumer,.provider,(.requestedRev // "-"),(.resolvedRev // "-"),.status]|@tsv' <<< "$workspace_json"
    jq -r 'select(.prQueryError != null) | "PR_QUERY_FAILED\t" + .prQueryError' <<< "$workspace_json"
    jq -r 'select(.pinScanError != null) | "PIN_SCAN_FAILED\t" + .pinScanError' <<< "$workspace_json"
    jq -r '.worktreeStatusFailures[]? | "WORKTREE_STATUS_FAILED\t" + .repository' <<< "$workspace_json"
  fi
fi

if [ "$command_name" = "doctor" ] && [ "$(jq -r .status <<< "$workspace_json")" != "passed" ]; then
  exit 1
fi
if [ "$command_name" = "release-status" ] && [ "$(jq -r .status <<< "$workspace_json")" != "complete" ]; then
  exit 1
fi
