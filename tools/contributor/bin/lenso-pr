#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-}"
shift || true

usage() {
  printf '%s\n' \
    'Usage: lenso-pr finish --repo <repository> --pr <number> --worktree <path> [--required-check <name>]... [--merge] [--method squash|merge|rebase] [--json]' \
    '' \
    'finish verifies checks, merge state, the remote merge commit/tree, and then asks Worktrunk' \
    'to remove only the clean integrated worktree and branch. It never uses force flags.'
}

if [ "$command_name" = "-h" ] || [ "$command_name" = "--help" ] || [ -z "$command_name" ]; then
  usage
  [ -n "$command_name" ] && exit 0 || exit 2
fi
if [ "$command_name" != "finish" ]; then
  printf 'Unknown command: %s\n' "$command_name" >&2
  usage >&2
  exit 2
fi

repo_argument=""
pr_number=""
worktree_argument=""
merge_pr=false
merge_method="squash"
output_json=false
required_checks=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) repo_argument="${2:-}"; shift ;;
    --pr) pr_number="${2:-}"; shift ;;
    --worktree) worktree_argument="${2:-}"; shift ;;
    --required-check) required_checks+=("${2:-}"); shift ;;
    --merge) merge_pr=true ;;
    --method) merge_method="${2:-}"; shift ;;
    --json) output_json=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

for required_command in git gh jq wt; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'ERROR missing command: %s\n' "$required_command" >&2
    exit 1
  fi
done

is_transient_github_error() {
  grep -Eiq '(^|[^0-9])(500|502|503|504)([^0-9]|$)|EOF|TLS|SSL_ERROR|timed out|timeout|connection reset|temporarily unavailable' "$1"
}

gh_retry() (
  local attempt=1
  local delay_seconds=1
  local error_file
  local exit_code
  local output_file=""
  error_file="$(mktemp -t lenso-pr-gh.XXXXXX)"
  cleanup_gh_retry_files() {
    if [ -e "$error_file" ]; then
      unlink "$error_file"
    fi
    if [ -n "$output_file" ] && [ -e "$output_file" ]; then
      unlink "$output_file"
    fi
  }
  trap cleanup_gh_retry_files EXIT
  output_file="$(mktemp -t lenso-pr-gh-output.XXXXXX)"
  while true; do
    : >"$error_file"
    : >"$output_file"
    if gh "$@" >"$output_file" 2>"$error_file"; then
      cat "$output_file"
      return 0
    else
      exit_code=$?
    fi
    if [ "$exit_code" -eq 8 ] && [ "${1:-}" = "pr" ] && [ "${2:-}" = "checks" ]; then
      # `gh pr checks --json` uses 8 for a valid pending-check snapshot.
      cat "$output_file"
      return 0
    fi
    if [ "$attempt" -ge 4 ] || ! is_transient_github_error "$error_file"; then
      sed -n '1,8p' "$error_file" >&2
      return "$exit_code"
    fi
    printf 'WARN transient GitHub failure; retrying in %ss (%s/4): %s\n' \
      "$delay_seconds" "$attempt" "$(sed -n '1p' "$error_file")" >&2
    sleep "$delay_seconds"
    attempt=$((attempt + 1))
    delay_seconds=$((delay_seconds * 2))
  done
)

if [ -z "$repo_argument" ] || [ -z "$pr_number" ] || [ -z "$worktree_argument" ]; then
  printf 'ERROR --repo, --pr, and --worktree are required\n' >&2
  usage >&2
  exit 2
fi
case "$pr_number" in
  *[!0-9]*|'') printf 'ERROR --pr must be a positive integer\n' >&2; exit 2 ;;
esac
case "$merge_method" in
  squash|merge|rebase) ;;
  *) printf 'ERROR unsupported merge method: %s\n' "$merge_method" >&2; exit 2 ;;
esac
if [ "${#required_checks[@]}" -gt 0 ]; then
  for required_check in "${required_checks[@]}"; do
    if [ -z "$required_check" ] || [ "${#required_check}" -gt 200 ]; then
      printf 'ERROR --required-check must be a non-empty check name of at most 200 characters\n' >&2
      exit 2
    fi
  done
fi
if $merge_pr && [ "${#required_checks[@]}" -eq 0 ]; then
  printf 'ERROR --merge requires at least one explicit --required-check\n' >&2
  exit 2
fi

repo_root="$(git -C "$repo_argument" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  printf 'ERROR repository is not a Git worktree: %s\n' "$repo_argument" >&2
  exit 1
fi
worktree_argument="$(cd "$worktree_argument" 2>/dev/null && pwd -P || true)"
worktree_root="$(git -C "$worktree_argument" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$worktree_root" ] || [ "$worktree_root" != "$worktree_argument" ]; then
  printf 'ERROR --worktree must be the exact root of a live Git worktree\n' >&2
  exit 1
fi
repo_common_directory="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
worktree_common_directory="$(git -C "$worktree_root" rev-parse --path-format=absolute --git-common-dir)"
if [ "$repo_common_directory" != "$worktree_common_directory" ]; then
  printf 'ERROR target worktree does not belong to the requested repository\n' >&2
  exit 1
fi
if [ -n "$(git -C "$worktree_root" status --porcelain=v1 --untracked-files=normal)" ]; then
  printf 'ERROR target worktree is dirty; preserving it: %s\n' "$worktree_root" >&2
  exit 1
fi
case "$PWD/" in
  "$worktree_root"/*) printf 'ERROR run lenso-pr outside the worktree it will remove\n' >&2; exit 1 ;;
esac

remote_url="$(git -C "$repo_root" remote get-url origin)"
case "$remote_url" in
  https://github.com/*) repository_slug="${remote_url#https://github.com/}" ;;
  git@github.com:*) repository_slug="${remote_url#git@github.com:}" ;;
  ssh://git@github.com/*) repository_slug="${remote_url#ssh://git@github.com/}" ;;
  *) printf 'ERROR origin is not a GitHub repository: %s\n' "$remote_url" >&2; exit 1 ;;
esac
repository_slug="${repository_slug%.git}"
if [[ ! "$repository_slug" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
  printf 'ERROR origin does not identify one GitHub repository: %s\n' "$remote_url" >&2
  exit 1
fi
repository_slug="$(gh_retry repo view "$repository_slug" --json nameWithOwner --jq .nameWithOwner)"
pr_json="$(gh_retry pr view "$pr_number" --repo "$repository_slug" --json state,isDraft,mergeable,mergeStateStatus,headRefName,baseRefName,headRefOid,mergeCommit,url,title)"
head_branch="$(jq -r .headRefName <<< "$pr_json")"
worktree_branch="$(git -C "$worktree_root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ "$worktree_branch" != "$head_branch" ]; then
  printf 'ERROR worktree branch %s does not match PR head %s\n' "${worktree_branch:-DETACHED}" "$head_branch" >&2
  exit 1
fi
pr_head_sha="$(jq -r '.headRefOid // empty' <<< "$pr_json")"
worktree_head_sha="$(git -C "$worktree_root" rev-parse HEAD)"
if [ -z "$pr_head_sha" ] || [ "$worktree_head_sha" != "$pr_head_sha" ]; then
  printf 'ERROR worktree HEAD %s does not match PR head %s\n' "$worktree_head_sha" "${pr_head_sha:-unavailable}" >&2
  exit 1
fi

checks_json=""
check_discovery_attempt=1
while true; do
  checks_json="$(gh_retry pr checks "$pr_number" --repo "$repository_slug" --json bucket,name,state,link)"
  missing_checks=()
  if [ "${#required_checks[@]}" -gt 0 ]; then
    for required_check in "${required_checks[@]}"; do
      if ! jq -e --arg name "$required_check" 'any(.[]; .name == $name)' \
        >/dev/null 2>&1 <<< "$checks_json"; then
        missing_checks+=("$required_check")
      fi
    done
  fi
  if [ "${#missing_checks[@]}" -eq 0 ]; then
    break
  fi
  if ! $merge_pr || [ "$check_discovery_attempt" -ge 12 ]; then
    printf 'ERROR required PR checks are not observable: %s\n' \
      "$(IFS=', '; printf '%s' "${missing_checks[*]}")" >&2
    exit 1
  fi
  printf 'WAIT required PR checks are not observable yet (%s/12): %s\n' \
    "$check_discovery_attempt" "$(IFS=', '; printf '%s' "${missing_checks[*]}")" >&2
  sleep 5
  check_discovery_attempt=$((check_discovery_attempt + 1))
done
if ! jq -e 'type == "array" and length > 0' >/dev/null <<< "$checks_json"; then
  printf 'ERROR PR has no observable checks; refusing to treat it as verified\n' >&2
  exit 1
fi
if jq -e 'any(.[]; .bucket == "fail" or .bucket == "cancel")' >/dev/null <<< "$checks_json"; then
  jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | "ERROR check " + .name + " is " + .state' <<< "$checks_json" >&2
  exit 1
fi
if jq -e 'any(.[]; .bucket == "pending")' >/dev/null <<< "$checks_json"; then
  if ! $merge_pr; then
    printf 'ERROR PR checks are still pending\n' >&2
    exit 1
  fi
  gh_retry pr checks "$pr_number" --repo "$repository_slug" --watch --fail-fast >&2
  checks_json="$(gh_retry pr checks "$pr_number" --repo "$repository_slug" --json bucket,name,state,link)"
fi
if ! jq -e 'all(.[]; .bucket == "pass" or .bucket == "skipping")' >/dev/null <<< "$checks_json"; then
  printf 'ERROR PR checks are not all terminal-successful\n' >&2
  exit 1
fi

state="$(jq -r .state <<< "$pr_json")"
if [ "$state" != "MERGED" ]; then
  if ! $merge_pr; then
    printf 'ERROR PR is %s; pass --merge to authorize merging after verification\n' "$state" >&2
    exit 1
  fi
  if [ "$(jq -r .isDraft <<< "$pr_json")" = "true" ]; then
    printf 'ERROR PR is a draft\n' >&2
    exit 1
  fi
  if [ "$(jq -r .mergeable <<< "$pr_json")" != "MERGEABLE" ]; then
    printf 'ERROR PR is not mergeable: %s\n' "$(jq -r .mergeStateStatus <<< "$pr_json")" >&2
    exit 1
  fi
  merge_error_file="$(mktemp -t lenso-pr-merge.XXXXXX)"
  cleanup_merge_error_file() {
    if [ -e "$merge_error_file" ]; then
      unlink "$merge_error_file"
    fi
  }
  trap cleanup_merge_error_file EXIT
  merge_attempt=1
  merge_delay_seconds=1
  while true; do
    if gh pr merge "$pr_number" --repo "$repository_slug" "--$merge_method" --delete-branch \
      >/dev/null 2>"$merge_error_file"; then
      break
    else
      merge_exit=$?
    fi
    pr_json="$(gh_retry pr view "$pr_number" --repo "$repository_slug" --json state,isDraft,mergeable,mergeStateStatus,headRefName,baseRefName,headRefOid,mergeCommit,url,title)"
    if [ "$(jq -r .state <<< "$pr_json")" = "MERGED" ]; then
      break
    fi
    if [ "$merge_attempt" -ge 4 ] || ! is_transient_github_error "$merge_error_file"; then
      sed -n '1,8p' "$merge_error_file" >&2
      exit "$merge_exit"
    fi
    printf 'WARN transient GitHub merge failure; PR remains open, retrying in %ss (%s/4): %s\n' \
      "$merge_delay_seconds" "$merge_attempt" "$(sed -n '1p' "$merge_error_file")" >&2
    sleep "$merge_delay_seconds"
    merge_attempt=$((merge_attempt + 1))
    merge_delay_seconds=$((merge_delay_seconds * 2))
  done
  cleanup_merge_error_file
  trap - EXIT
  pr_json="$(gh_retry pr view "$pr_number" --repo "$repository_slug" --json state,isDraft,mergeable,mergeStateStatus,headRefName,baseRefName,headRefOid,mergeCommit,url,title)"
fi

if [ "$(jq -r .state <<< "$pr_json")" != "MERGED" ]; then
  printf 'ERROR PR did not reach MERGED state\n' >&2
  exit 1
fi
merge_sha="$(jq -r '.mergeCommit.oid // empty' <<< "$pr_json")"
base_branch="$(jq -r .baseRefName <<< "$pr_json")"
if [ -z "$merge_sha" ]; then
  printf 'ERROR merged PR has no merge commit\n' >&2
  exit 1
fi

git -C "$repo_root" fetch origin --prune
if ! git -C "$repo_root" merge-base --is-ancestor "$merge_sha" "origin/$base_branch"; then
  printf 'ERROR merge commit %s is not reachable from origin/%s\n' "$merge_sha" "$base_branch" >&2
  exit 1
fi
local_tree="$(git -C "$repo_root" show -s --format=%T "$merge_sha")"
remote_tree="$(gh_retry api "repos/$repository_slug/git/commits/$merge_sha" --jq .tree.sha)"
if [ "$local_tree" != "$remote_tree" ]; then
  printf 'ERROR local tree %s does not match GitHub tree %s\n' "$local_tree" "$remote_tree" >&2
  exit 1
fi

removal_json="$(wt -C "$repo_root" remove --foreground --format=json "$worktree_root")"
if ! jq -e '.branch_outcome == "deleted" or .branch_outcome == "not_attempted"' >/dev/null <<< "$removal_json"; then
  printf 'ERROR Worktrunk preserved the branch: %s\n' "$(jq -r .branch_outcome <<< "$removal_json")" >&2
  exit 1
fi

result="$(jq -cn \
  --arg schema 'lenso.pr-finish.v1' \
  --arg repository "$repository_slug" \
  --argjson pr "$pr_number" \
  --arg url "$(jq -r .url <<< "$pr_json")" \
  --arg mergeCommit "$merge_sha" \
  --arg tree "$local_tree" \
  --arg baseBranch "$base_branch" \
  --arg worktree "$worktree_root" \
  --argjson checks "$checks_json" \
  --argjson removal "$removal_json" \
  '{schema:$schema,repository:$repository,pr:$pr,url:$url,baseBranch:$baseBranch,mergeCommit:$mergeCommit,tree:$tree,checks:$checks,worktree:$worktree,removal:$removal,status:"complete"}')"

if $output_json; then
  jq . <<< "$result"
else
  jq -r '"MERGED\t" + .url, "COMMIT\t" + .mergeCommit, "TREE\t" + .tree, "WORKTREE\tremoved\t" + .worktree' <<< "$result"
fi
