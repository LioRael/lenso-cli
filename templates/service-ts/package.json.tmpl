{
  "name": "{{package_name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --env-file-if-exists=.env.local src/server.ts --check",
    "dev": "node --env-file-if-exists=.env.local src/server.ts",
    "module:release": "node --env-file-if-exists=.env.local src/server.ts --check-release",
    "service:package": "lenso service package .",
    "service:verify": "lenso service verify ./lenso.service.json --serve-command \"pnpm start\"",
    "start": "node --env-file-if-exists=.env.local src/server.ts"
  },
  "dependencies": {
    "@lenso/service-kit": {{service_kit_dependency}}
  }
}
