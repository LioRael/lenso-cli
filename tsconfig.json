{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "outDir": "bin",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/lenso.ts", "src/host.ts", "src/host-extract.ts", "src/host-owner.ts", "src/host-app.ts", "src/distribution-host.ts"]
}
